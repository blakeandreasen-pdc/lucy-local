# LAN IP of this docker host. The robot is told to connect here, and DNS must send
# *.trifo.com and *.lightfieldcamera.com.cn to it.
SERVER_IP=192.168.1.10
# Host port for the web UI / API
WEB_PORT=8110
# Time zone for schedules
TZ=America/Denver
# Optional: Home Assistant MQTT password (otherwise set it on the Settings page)
HA_MQTT_PASSWORD=
